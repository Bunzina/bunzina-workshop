    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "amqplib": "^0.10.5",
    "elysia": "^1.4.28",
    "http-status-codes": "^2.3.0",
    "prom-client": "^15.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
